@article{https://doi.org/10.1111/nph.70645,
author = {Cavender-Bares, Jeannine and White, Dawson M. and Ahlstrand, Natalie Iwanycki and Austin, Matthew W. and Bastianelli, Denis and Bazan, Samantha and Boughalmi, Khalil and Cardinal-McTeague, Warren and Chacón-Madrigal, Eduardo and Couvreur, Thomas L. P. and Davis, Charles and Durgante, Flávia M. and Grace, Olwen M. and Guzmán Q., J. Antonio and Hansen, Kimberly and Hernández-Leal, Mariana S. and Hopkins, Michael John Gilbert and Jackson, Rykkar and Kothari, Shan and Lee, Aaron K. and Léveillé-Bourret, Étienne and Pinto-Ledezma, Jesús and Quinteros Casaverde, Natalia L. and Meireles, Jose Eduardo and Neto-Bradley, Barbara and Nichodemus, Cornelius Onyedikachi and Ree, Richard H. and Schmull, Michaela and Soltis, Douglas E. and Soltis, Pamela S. and Tuomisto, Hanna and Ustin, Susan L. and Vasconcelos, Caroline C.},
title = {Next-generation specimen digitization: capturing reflectance spectra from the world's herbaria for modeling plant biology across time, space, and taxa},
journal = {New Phytologist},
volume = {251},
number = {2},
pages = {645-665},
keywords = {collection management, global herbarium, methodological standards, next-generation digitization, plant functional traits, spectral reflectance},
doi = {https://doi.org/10.1111/nph.70645},
url = {https://nph.onlinelibrary.wiley.com/doi/abs/10.1111/nph.70645},
eprint = {https://nph.onlinelibrary.wiley.com/doi/pdf/10.1111/nph.70645},
abstract = {Summary Spectral reflectance measured from herbarium specimens represents a potentially vast source of information relevant to plant taxon identification and functional traits, which has inspired many laboratories world-wide to initiate next-generation spectral digitization from specimens. Combining these datasets into a coordinated global database would generate new capacity to model plant traits globally, enabling connection with remote sensing and ecological and biosphere models, as well as reconstruction of trait evolution. However, coordination is needed to avoid downstream problems in data aggregation due to variation in data standards and technical specifications of the instruments, optical setups, or measurement protocols. The International Herbarium Spectral Digitization (IHerbSpec) working group has initiated a globally collaborative program, outlining the central issues to address in establishing protocols, standards, and best practices, and proposing next steps. This collaborative effort will allow generation of replicable spectral reflectance data from plant specimens housed in herbaria around the world within ongoing digitization programs following community-defined standards and Findable, Accessible, Interoperable, and Reusable (FAIR) principles.},
year = {2026}
}

